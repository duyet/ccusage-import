# Copy to `.env` (gitignored). CLI also reads ~/.config/summa/{config.toml,credentials.toml}.
# Worker local secrets: copy apps/api/.dev.vars.example → apps/api/.dev.vars
# Production Worker secrets: `bun run --filter @summa/api secret:put` / wrangler secret put

# --- CLI (`@summa/cli`, binary `summa`) ---

# Config files (optional; defaults to XDG ~/.config/summa/)
# SUMMA_CONFIG=
# SUMMA_CREDENTIALS=

# Local DuckDB or MotherDuck
# DUCKDB_PATH=~/.local/share/summa/summa.duckdb
# DUCKDB_PATH=md:ccusage
MOTHERDUCK_TOKEN=

# ClickHouse (must be reachable from this machine)
CH_HOST=
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=default
CH_PROTOCOL=http

# Cloud hub — every machine POSTs here
SUMMA_TELEMETRY_ENDPOINT=https://summa.duyet.net
SUMMA_TELEMETRY_TOKEN=

# Cursor account-wide usage
# CURSOR_SESSION=WorkosCursorSessionToken=…
# CURSOR_COOKIE=
# CURSOR_API_KEY=

# Optional importer
# IMPORT_MACHINE_NAME=
# IMPORT_DAYS_BACK=2
# IMPORT_COMMAND_TIMEOUT_MS=
# OPENCODE_DATA_DIR=
# CODEX_HOME=
# GROK_HOME=

# Installer
# SUMMA_INSTALL_DIR=~/.local/bin
# SUMMA_SETUP_CRON=1
# SUMMA_CRON_EVERY=1h

# --- API Worker (`@summa/api`, summa.duyet.net) ---
# Put the same CH_* / MOTHERDUCK_* in wrangler secrets (public hostname for CH).
# D1 is keys/accounts only — not usage rows.

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BOOTSTRAP_TOKEN=

MOTHERDUCK_DATABASE=ccusage
# MOTHERDUCK_SQL_URL=

# Cloudflare (optional; wrangler login is enough locally)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
